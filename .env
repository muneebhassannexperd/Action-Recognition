# ── Redis ────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Edge identity (required) ────────────────────────────────────
ORGANIZATION_ID=1
DEVICE_ID=edge-node-01

# ── MS-3 camera discovery ────────────────────────────────────────
# On startup the service calls:
#   GET {MS3_URL}/api/edge/devices/{DEVICE_ID}/cameras
# to fetch the list of assigned camera IDs (e.g. [4, 5, 9]).
# Leave empty for local testing and use CAMERA_IDS fallback instead.
MS3_URL=

# Fallback: if MS3_URL is empty, use this comma-separated list instead.
CAMERA_IDS=4,5

# Channel schema (built automatically):
#   Subscribe: org:{ORGANIZATION_ID}:device:{DEVICE_ID}:base_detection:*
#   Publish:   org:{ORGANIZATION_ID}:device:{DEVICE_ID}:behavior_cues:{family}:{camera_id}
#   Commands:  device:{DEVICE_ID}:commands  (add_camera / remove_camera)

# ── Device ───────────────────────────────────────────────────────
# cuda or cpu
DEVICE=cpu

# ── Model ────────────────────────────────────────────────────────
# posec3d or ctrgcn
ACTION_MODEL=posec3d
# Override default checkpoint path (leave empty for auto-resolve)
POSEC3D_WEIGHTS=

# ── Pipeline tuning ─────────────────────────────────────────────
WINDOW_SIZE=30
INFERENCE_STRIDE=15
EVENT_MIN_CONFIDENCE=0.12
INTERACTION_DISTANCE=300.0
INTERACTION_FRAMES=15

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
