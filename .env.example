# ── Redis ────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Camera routing (required) ───────────────────────────────────
# One container per camera.  These build the Redis channel names:
#   Subscribe: org:{ORGANIZATION_ID}:base_detection:{CAMERA_ID}
#   Publish:   org:{ORGANIZATION_ID}:behavior_cues:{family}:{CAMERA_ID}
ORGANIZATION_ID=1
CAMERA_ID=4

# Edge only: adds device:{DEVICE_ID}: segment to subscribe channel.
# Leave empty for cloud deployment.
#   Subscribe: org:{ORGANIZATION_ID}:device:{DEVICE_ID}:base_detection:{CAMERA_ID}
DEVICE_ID=

# ── Device ───────────────────────────────────────────────────────
# cuda or cpu
DEVICE=cuda

# ── Model ────────────────────────────────────────────────────────
# posec3d or ctrgcn
ACTION_MODEL=posec3d
# Override default checkpoint path (leave empty for auto-resolve)
POSEC3D_WEIGHTS=

# ── Pipeline tuning ─────────────────────────────────────────────
WINDOW_SIZE=100
INFERENCE_STRIDE=15
EVENT_MIN_CONFIDENCE=0.12
INTERACTION_DISTANCE=300.0
INTERACTION_FRAMES=15

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
